{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chess — Python multiplayer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/web/server.py",
      "python": "${workspaceFolder}/web/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/web",
      "args": ["--host", "0.0.0.0", "--port", "8766"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
